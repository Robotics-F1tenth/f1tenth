From: f1tenth mocap audit
Subject: [PATCH] aggregate NatNet callback and DDS publish timing

This patch targets upstream rolling commit
7b92128fe05ef6e5126d6727e5bf82bd60e02445. Verify the deployed checkout before
applying it.

The NatNet callback now emits one aggregate INFO record per approximately one
second. It reports native data->iFrame gaps, the maximum callback inter-arrival,
the maximum rigid-body publish duration, and the maximum callback work duration.
There is no per-frame logging. std::chrono::steady_clock is used so wall-clock
adjustments do not contaminate the timing measurements.

diff --git a/mocap4r2_optitrack_driver/include/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.hpp b/mocap4r2_optitrack_driver/include/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.hpp
index 4cea2e8..c2e0815 100644
--- a/mocap4r2_optitrack_driver/include/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.hpp
+++ b/mocap4r2_optitrack_driver/include/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.hpp
@@ -24,6 +24,7 @@
 #include <iostream>
 #include <sstream>
 #include <map>
+#include <cstdint>
 #include <string>
 #include <memory>
 #include <chrono>
@@ -111,6 +112,22 @@ protected:
   uint16_t server_data_port_;
 
   uint32_t frame_number_{0};
+
+  // Low-overhead NatNet/DDS timing diagnostics, aggregated in process_frame().
+  using SteadyClock = std::chrono::steady_clock;
+  bool timing_diagnostics_initialized_{false};
+  SteadyClock::time_point timing_window_start_;
+  SteadyClock::time_point last_callback_start_;
+  std::int64_t last_natnet_frame_{0};
+  std::int64_t timing_first_natnet_frame_{0};
+  std::int64_t timing_last_natnet_frame_{0};
+  std::int64_t timing_max_natnet_frame_delta_{0};
+  std::uint64_t timing_callback_count_{0};
+  std::uint64_t timing_missing_natnet_frames_{0};
+  std::uint64_t timing_nonmonotonic_natnet_frames_{0};
+  std::chrono::nanoseconds timing_max_callback_interarrival_{0};
+  std::chrono::nanoseconds timing_max_rigid_publish_duration_{0};
+  std::chrono::nanoseconds timing_max_callback_duration_{0};
 };
 
 void NATNET_CALLCONV process_frame_callback(sFrameOfMocapData * data, void * pUserData);
diff --git a/mocap4r2_optitrack_driver/src/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.cpp b/mocap4r2_optitrack_driver/src/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.cpp
index 78f5fa2..570d405 100644
--- a/mocap4r2_optitrack_driver/src/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.cpp
+++ b/mocap4r2_optitrack_driver/src/mocap4r2_optitrack_driver/mocap4r2_optitrack_driver.cpp
@@ -127,6 +127,44 @@ OptitrackDriverNode::process_frame(sFrameOfMocapData * data)
     return;
   }
 
+  const auto callback_start = SteadyClock::now();
+  const std::int64_t natnet_frame = static_cast<std::int64_t>(data->iFrame);
+
+  if (!timing_diagnostics_initialized_) {
+    timing_window_start_ = callback_start;
+    last_callback_start_ = callback_start;
+    last_natnet_frame_ = natnet_frame;
+    timing_diagnostics_initialized_ = true;
+  } else {
+    const auto callback_interarrival = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      callback_start - last_callback_start_);
+    if (callback_interarrival > timing_max_callback_interarrival_) {
+      timing_max_callback_interarrival_ = callback_interarrival;
+    }
+
+    const std::int64_t natnet_frame_delta = natnet_frame - last_natnet_frame_;
+    if (natnet_frame_delta > 0) {
+      if (natnet_frame_delta > timing_max_natnet_frame_delta_) {
+        timing_max_natnet_frame_delta_ = natnet_frame_delta;
+      }
+      if (natnet_frame_delta > 1) {
+        timing_missing_natnet_frames_ +=
+          static_cast<std::uint64_t>(natnet_frame_delta - 1);
+      }
+    } else {
+      ++timing_nonmonotonic_natnet_frames_;
+    }
+
+    last_callback_start_ = callback_start;
+    last_natnet_frame_ = natnet_frame;
+  }
+
+  if (timing_callback_count_ == 0) {
+    timing_first_natnet_frame_ = natnet_frame;
+  }
+  timing_last_natnet_frame_ = natnet_frame;
+  ++timing_callback_count_;
+
   frame_number_++;
   rclcpp::Duration frame_delay = rclcpp::Duration(get_optitrack_system_latency(data));
 
@@ -183,7 +221,49 @@ OptitrackDriverNode::process_frame(sFrameOfMocapData * data)
       msg_rb.rigidbodies.push_back(rb);
     }
 
+    const auto rigid_publish_start = SteadyClock::now();
     mocap4r2_rigid_body_pub_->publish(msg_rb);
+    const auto rigid_publish_duration = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      SteadyClock::now() - rigid_publish_start);
+    if (rigid_publish_duration > timing_max_rigid_publish_duration_) {
+      timing_max_rigid_publish_duration_ = rigid_publish_duration;
+    }
+  }
+
+  const auto callback_end = SteadyClock::now();
+  const auto callback_duration = std::chrono::duration_cast<std::chrono::nanoseconds>(
+    callback_end - callback_start);
+  if (callback_duration > timing_max_callback_duration_) {
+    timing_max_callback_duration_ = callback_duration;
+  }
+
+  if (callback_end - timing_window_start_ >= std::chrono::seconds(1)) {
+    const auto to_ms = [](const std::chrono::nanoseconds duration) {
+        return std::chrono::duration<double, std::milli>(duration).count();
+      };
+    RCLCPP_INFO(
+      get_logger(),
+      "NatNet timing: callbacks=%llu iFrame=%lld..%lld delta_max=%lld missing=%llu "
+      "nonmonotonic=%llu callback_dt_max=%.3fms rigid_publish_max=%.3fms "
+      "callback_work_max=%.3fms",
+      static_cast<unsigned long long>(timing_callback_count_),
+      static_cast<long long>(timing_first_natnet_frame_),
+      static_cast<long long>(timing_last_natnet_frame_),
+      static_cast<long long>(timing_max_natnet_frame_delta_),
+      static_cast<unsigned long long>(timing_missing_natnet_frames_),
+      static_cast<unsigned long long>(timing_nonmonotonic_natnet_frames_),
+      to_ms(timing_max_callback_interarrival_),
+      to_ms(timing_max_rigid_publish_duration_),
+      to_ms(timing_max_callback_duration_));
+
+    timing_window_start_ = callback_end;
+    timing_callback_count_ = 0;
+    timing_missing_natnet_frames_ = 0;
+    timing_nonmonotonic_natnet_frames_ = 0;
+    timing_max_natnet_frame_delta_ = 0;
+    timing_max_callback_interarrival_ = std::chrono::nanoseconds::zero();
+    timing_max_rigid_publish_duration_ = std::chrono::nanoseconds::zero();
+    timing_max_callback_duration_ = std::chrono::nanoseconds::zero();
   }
 }
 
